# Copy to .env.standalone and fill from a secret manager. Do not commit real values.
TCE_STANDALONE_DB_PASSWORD=
TCE_DATABASE_URL=postgresql+asyncpg://tce:URL_ENCODED_PASSWORD@db:5432/tce_client
TCE_STANDALONE_ENCRYPTION_KEY=
TCE_STANDALONE_STORAGE_DIR=/data/tce
TCE_STANDALONE_PUBLIC_URL=https://your-private-tce-host.example
TCE_STANDALONE_MCP_PORT=8876
TCE_STANDALONE_FROM_EMAIL=
TCE_STANDALONE_RESEND_API_KEY=
# Client OpenAI, Anthropic, Fathom and GitHub keys are entered in each workspace.
