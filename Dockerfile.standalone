FROM python:3.11-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir .
COPY alembic_standalone/ ./alembic_standalone/
COPY alembic_standalone.ini ./

RUN useradd --system --uid 10001 --create-home tce \
    && mkdir -p /data/tce \
    && chown -R tce:tce /data/tce
USER tce

ENV TCE_STANDALONE_STORAGE_DIR=/data/tce
EXPOSE 8000
CMD ["uvicorn", "tce.standalone.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
